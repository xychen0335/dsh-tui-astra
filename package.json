{
  "name": "dsh-tui-astra",
  "version": "0.1.0",
  "description": "Interactive terminal client for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "author": "xychen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xychen0335/dsh-tui-astra.git"
  },
  "homepage": "https://github.com/xychen0335/dsh-tui-astra#readme",
  "bugs": {
    "url": "https://github.com/xychen0335/dsh-tui-astra/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "cli",
    "tui",
    "coding-agent"
  ],
  "bin": {
    "dsh": "lib/index.js",
    "dsh-tui-astra": "lib/index.js"
  },
  "files": [
    "lib",
    "runtime"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node lib/index.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "clean": "rm -rf lib"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-spine-demo": "0.1.0-rc.6",
    "@deepseek-ai/dsh-bash-local": "0.1.0-rc.6",
    "@deepseek-ai/dsh-command-compact": "0.1.0-rc.6",
    "@deepseek-ai/dsh-command-goal": "0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.6",
    "@deepseek-ai/dsh-compaction-basic": "0.1.0-rc.6",
    "@deepseek-ai/dsh-fs-local": "0.1.0-rc.6",
    "@deepseek-ai/dsh-fs-observation-policy": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.0-rc.6",
    "@deepseek-ai/dsh-plan-mode": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sdk-client": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sdk-jsonrpc-demo": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sdk-jsonrpc-server": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-checkpoint-policy": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subagent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess-local": "0.1.0-rc.6",
    "@deepseek-ai/dsh-token-meter": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-fs": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-subagent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-todo": "0.1.0-rc.6",
    "ink": "6.8.0",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  }
}
